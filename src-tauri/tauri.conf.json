{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lime Slice",
  "version": "0.1.0",
  "identifier": "com.limeslice.slicer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:43117",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lime Slice",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
